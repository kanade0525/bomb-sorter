{
  "name": "bomb-sorter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "色と形でボムを仕分けるスマホ向けアクション。Vite + TypeScript + Canvas 2D。",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "check": "npm run format:check && npm run typecheck && npm run test:run && node tools/check.mjs",
    "e2e": "playwright test tests/e2e",
    "e2e:ui": "playwright test tests/e2e --ui",
    "shots": "playwright test tests/shots",
    "icons": "node tools/make-icons.mjs",
    "verify": "npm run check && npm run build && npm run e2e",
    "build:playables": "tsc --noEmit && PLAYABLES=1 vite build",
    "preview:playables": "vite preview --outDir dist-playables",
    "check:playables": "npm run build:playables && node tools/check-playables.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
